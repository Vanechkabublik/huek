# Скопируйте в .env, если нужно поменять значения по умолчанию:  cp .env.example .env
APP_PORT=8080
ADMINER_PORT=8082

DB_NAME=ads
DB_USER=ads_user
DB_PASS=ads_pass

APP_TIMEZONE=Europe/Moscow
# 1 — показывать текст исключений в JSON-ответах (только для разработки)
APP_DEBUG=0
# 1 — показывать на странице входа кнопки быстрого входа (демо-пароли). На боевом сервере выключено
APP_DEMO=1

# --- Чат и вход через Яндекс / Google ---
# Порт WebSocket-сервера чата (на хосте)
WS_PORT=8081
# Секрет для подписи WebSocket-тикетов. Пусто — выводится из DB_PASS. Сгенерировать: openssl rand -hex 32
APP_SECRET=
# Публичный адрес сайта (нужен для входа через Яндекс/Google: Redirect URI = APP_URL/oauth-callback.php)
APP_URL=
# Ключи приложений. Пусто — кнопка скрыта. Где взять — docs/OAUTH_LOGIN.md
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ручной адрес WebSocket (обычно не нужен): по http — ws://хост:8081, по https — wss://домен/ws
WS_PUBLIC_URL=
