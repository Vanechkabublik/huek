# Боевые настройки. Скопируйте: cp .env.prod.example .env  — и заполните.

# Поддомен, который уже указывает A-записью на IP сервера
DOMAIN=board.example.com
# Email для Let's Encrypt (придёт письмо, если сертификат не удастся продлить)
ACME_EMAIL=you@example.com

# ВАЖНО: задайте до ПЕРВОГО запуска — пароль БД записывается в том pg_data один раз
DB_NAME=ads
DB_USER=ads_user
DB_PASS=замените_на_длинный_случайный_пароль

APP_TIMEZONE=Europe/Moscow

# Секрет подписи WebSocket-тикетов чата. Сгенерировать:  openssl rand -hex 32
APP_SECRET=

# Публичный адрес сайта (по умолчанию https://DOMAIN). Нужен для входа через Яндекс и Google
#APP_URL=https://board.example.com

# Вход через Яндекс и Google. Проще всего заполнить скриптом:  bash bin/setup-oauth.sh
# (он спросит ключи со скрытым вводом). Пошаговая инструкция — docs/OAUTH_LOGIN.md. Пусто — кнопка скрыта
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1 — залить демо-данные и показать кнопки быстрого входа с демо-паролями (на боевом сервере оставьте 0)
APP_DEMO=0
