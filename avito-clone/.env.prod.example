# Боевые настройки. Скопируйте: cp .env.prod.example .env  — и заполните.

# Поддомен, который уже указывает A-записью на IP сервера
DOMAIN=board.example.com
# Email для Let's Encrypt (придёт письмо, если сертификат не удастся продлить)
ACME_EMAIL=you@example.com

# ВАЖНО: задайте до ПЕРВОГО запуска — пароль БД записывается в том pg_data один раз
DB_NAME=ads
DB_USER=ads_user
DB_PASS=замените_на_длинный_случайный_пароль

APP_TIMEZONE=Europe/Moscow
