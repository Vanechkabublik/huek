# Боевые настройки. Скопируйте: cp .env.prod.example .env  — и заполните.

# Поддомен, который уже указывает A-записью на IP сервера
DOMAIN=board.example.com
# Email для Let's Encrypt (придёт письмо, если сертификат не удастся продлить)
ACME_EMAIL=you@example.com

# ВАЖНО: задайте до ПЕРВОГО запуска — пароль БД записывается в том pg_data один раз
DB_NAME=ads
DB_USER=ads_user
DB_PASS=замените_на_длинный_случайный_пароль

APP_TIMEZONE=Europe/Moscow

# Секрет подписи WebSocket-тикетов чата. Сгенерировать:  openssl rand -hex 32
APP_SECRET=

# Публичный адрес сайта (по умолчанию https://DOMAIN). Нужен для входа через Яндекс и Google
#APP_URL=https://board.example.com

# Вход через Яндекс и Google. Проще всего заполнить скриптом:  bash bin/setup-oauth.sh
# (он спросит ключи со скрытым вводом). Пошаговая инструкция — docs/OAUTH_LOGIN.md. Пусто — кнопка скрыта
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Определение города по геолокации браузера идёт через OpenStreetMap Nominatim (бесплатный публичный сервис,
# лимит ~1 запрос/сек: для большого трафика поднимите свой Nominatim или укажите другой совместимый адрес)
#GEOCODER_URL=https://nominatim.openstreetmap.org/reverse

# Доверенные прокси (через запятую, CIDR), от которых принимается X-Forwarded-For — нужно для реального IP посетителя.
# По умолчанию доверяются localhost и частные сети (docker, nginx на этом же сервере) — обычно менять не нужно.
#TRUSTED_PROXIES=

# Звонки (голос и видео). Звук и видео идут напрямую между браузерами, а если это невозможно — через TURN-сервер coturn
# (запускается тем же docker compose). Секрет общий у приложения и coturn; bin/server-update.sh сам его генерирует:
#   openssl rand -hex 24
TURN_SECRET=
# Публичный IP сервера для coturn (скрипт обновления определяет его сам). Нужен, если сервер за NAT хостинга
TURN_EXTERNAL_IP=
#TURN_HOST=board.example.com
#TURN_PORT=3478
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49200
# 1 — все звонки только через TURN: собеседники не увидят IP друг друга, но задержка выше
#CALLS_RELAY_ONLY=1

# 1 — залить демо-данные и показать кнопки быстрого входа с демо-паролями (на боевом сервере оставьте 0)
APP_DEMO=0
